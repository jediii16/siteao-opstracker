generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  COMMITTEE
}

enum ItemCondition {
  GOOD
  FAIR
  DAMAGED
  UNDER_REPAIR
  LOST
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  BORROWED
  RETURNED
}

enum ReturnCondition {
  GOOD
  FAIR
  DAMAGED
  LOST
}

enum TransactionType {
  ITEM_ADDED
  QUANTITY_INCREASED
  QUANTITY_DECREASED
  BORROWED
  RETURNED
  DAMAGED
  LOST
  ADJUSTMENT
}

model Committee {
  id                String             @id @default(uuid()) @map("id") @db.Uuid
  name              String             @unique @map("name") @db.VarChar(100)
  description       String?            @map("description") @db.Text
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamp(3)
  users             User[]
  borrowingRequests BorrowingRequest[]
  auditLogs         AuditLog[]

  @@map("committees")
}

model User {
  id                         String                 @id @default(uuid()) @map("id") @db.Uuid
  committeeId                String?                @unique @map("committee_id") @db.Uuid
  username                   String                 @unique @map("username") @db.VarChar(50)
  passwordHash               String                 @map("password_hash") @db.Text
  role                       UserRole               @map("role")
  isActive                   Boolean                @default(true) @map("is_active")
  passwordChangedAt          DateTime?              @map("password_changed_at") @db.Timestamp(3)
  lastLoginAt                DateTime?              @map("last_login_at") @db.Timestamp(3)
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt                  DateTime               @updatedAt @map("updated_at") @db.Timestamp(3)
  committee                  Committee?             @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  categoriesCreated          Category[]             @relation("CategoryCreatedBy")
  itemsCreated               Item[]                 @relation("ItemCreatedBy")
  itemsUpdated               Item[]                 @relation("ItemUpdatedBy")
  borrowingRequestsSubmitted BorrowingRequest[]     @relation("SubmittedBy")
  borrowingRequestsApproved  BorrowingRequest[]     @relation("ApprovedBy")
  borrowingRequestsRejected  BorrowingRequest[]     @relation("RejectedBy")
  borrowingRequestsCancelled BorrowingRequest[]     @relation("CancelledBy")
  inventoryTransactions      InventoryTransaction[]
  auditLogs                  AuditLog[]
  refreshTokens              RefreshToken[]
  systemSettingsUpdated      SystemSetting[]        @relation("SystemSettingUpdatedBy")

  @@index([committeeId])
  @@map("users")
}

model SystemSetting {
  id                 String   @id @default("siteao") @map("id") @db.VarChar(32)
  siteaoGovernorName String   @default("HON. JHERMIE P. LICAROS") @map("siteao_governor_name") @db.VarChar(150)
  updatedBy          String?  @map("updated_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamp(3)
  updater            User?    @relation("SystemSettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([updatedBy])
  @@map("system_settings")
}

model Category {
  id          String   @id @default(uuid()) @map("id") @db.Uuid
  name        String   @unique @map("name") @db.VarChar(100)
  description String?  @map("description") @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(3)
  creator     User     @relation("CategoryCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  items       Item[]

  @@index([createdBy])
  @@map("categories")
}

model Item {
  id                    String                 @id @default(uuid()) @map("id") @db.Uuid
  itemCode              String                 @unique @map("item_code") @db.VarChar(50)
  categoryId            String                 @map("category_id") @db.Uuid
  itemName              String                 @map("item_name") @db.VarChar(150)
  description           String?                @map("description") @db.Text
  totalQuantity         Int                    @map("total_quantity")
  availableQuantity     Int                    @map("available_quantity")
  condition             ItemCondition          @map("condition")
  storageLocation       String                 @map("storage_location") @db.VarChar(150)
  googleDriveFolderLink String?                @map("google_drive_folder_link") @db.Text
  isActive              Boolean                @default(true) @map("is_active")
  createdBy             String                 @map("created_by") @db.Uuid
  updatedBy             String?                @map("updated_by") @db.Uuid
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamp(3)
  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator               User                   @relation("ItemCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater               User?                  @relation("ItemUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  borrowingRequestItems BorrowingRequestItem[]
  inventoryTransactions InventoryTransaction[]

  @@index([categoryId])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([condition])
  @@index([isActive])
  @@map("items")
}

model BorrowingRequest {
  id                    String                 @id @default(uuid()) @map("id") @db.Uuid
  requestCode           String                 @unique @map("request_code") @db.VarChar(50)
  committeeId           String                 @map("committee_id") @db.Uuid
  submittedBy           String                 @map("submitted_by") @db.Uuid
  requesterName         String                 @map("requester_name") @db.VarChar(150)
  requesterPosition     String                 @map("requester_position") @db.VarChar(100)
  purpose               String                 @map("purpose") @db.Text
  borrowDate            DateTime               @map("borrow_date") @db.Date
  expectedReturnDate    DateTime               @map("expected_return_date") @db.Date
  additionalNotes       String?                @map("additional_notes") @db.Text
  status                RequestStatus          @default(PENDING) @map("status")
  rejectionReason       String?                @map("rejection_reason") @db.Text
  cancellationReason    String?                @map("cancellation_reason") @db.Text
  approvedBy            String?                @map("approved_by") @db.Uuid
  approvedAt            DateTime?              @map("approved_at") @db.Timestamp(3)
  rejectedBy            String?                @map("rejected_by") @db.Uuid
  rejectedAt            DateTime?              @map("rejected_at") @db.Timestamp(3)
  cancelledBy           String?                @map("cancelled_by") @db.Uuid
  cancelledAt           DateTime?              @map("cancelled_at") @db.Timestamp(3)
  borrowedAt            DateTime?              @map("borrowed_at") @db.Timestamp(3)
  returnedAt            DateTime?              @map("returned_at") @db.Timestamp(3)
  submittedAt           DateTime               @default(now()) @map("submitted_at") @db.Timestamp(3)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamp(3)
  committee             Committee              @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  submitter             User                   @relation("SubmittedBy", fields: [submittedBy], references: [id], onDelete: Restrict)
  approver              User?                  @relation("ApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  rejector              User?                  @relation("RejectedBy", fields: [rejectedBy], references: [id], onDelete: SetNull)
  canceller             User?                  @relation("CancelledBy", fields: [cancelledBy], references: [id], onDelete: SetNull)
  items                 BorrowingRequestItem[]
  inventoryTransactions InventoryTransaction[]

  @@index([committeeId])
  @@index([submittedBy])
  @@index([status])
  @@index([borrowDate])
  @@index([expectedReturnDate])
  @@map("borrowing_requests")
}

model BorrowingRequestItem {
  id                 String           @id @default(uuid()) @map("id") @db.Uuid
  borrowingRequestId String           @map("borrowing_request_id") @db.Uuid
  itemId             String           @map("item_id") @db.Uuid
  quantityRequested  Int              @map("quantity_requested")
  quantityApproved   Int?             @map("quantity_approved")
  quantityReleased   Int?             @map("quantity_released")
  quantityReturned   Int              @default(0) @map("quantity_returned")
  returnCondition    ReturnCondition? @map("return_condition")
  returnNotes        String?          @map("return_notes") @db.Text
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamp(3)
  borrowingRequest   BorrowingRequest @relation(fields: [borrowingRequestId], references: [id], onDelete: Cascade)
  item               Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([borrowingRequestId, itemId])
  @@index([borrowingRequestId])
  @@index([itemId])
  @@map("borrowing_request_items")
}

model InventoryTransaction {
  id                 String            @id @default(uuid()) @map("id") @db.Uuid
  itemId             String            @map("item_id") @db.Uuid
  borrowingRequestId String?           @map("borrowing_request_id") @db.Uuid
  performedBy        String            @map("performed_by") @db.Uuid
  transactionType    TransactionType   @map("transaction_type")
  quantity           Int               @map("quantity")
  quantityBefore     Int               @map("quantity_before")
  quantityAfter      Int               @map("quantity_after")
  remarks            String?           @map("remarks") @db.Text
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamp(3)
  item               Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  borrowingRequest   BorrowingRequest? @relation(fields: [borrowingRequestId], references: [id], onDelete: Restrict)
  performer          User              @relation(fields: [performedBy], references: [id], onDelete: Restrict)

  @@index([itemId])
  @@index([borrowingRequestId])
  @@index([performedBy])
  @@index([transactionType])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model AuditLog {
  id          String     @id @default(uuid()) @map("id") @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  committeeId String?    @map("committee_id") @db.Uuid
  action      String     @map("action") @db.VarChar(100)
  entityType  String     @map("entity_type") @db.VarChar(100)
  entityId    String?    @map("entity_id") @db.Uuid
  description String     @map("description") @db.Text
  oldValues   Json?      @map("old_values") @db.JsonB
  newValues   Json?      @map("new_values") @db.JsonB
  ipAddress   String?    @map("ip_address") @db.VarChar(45)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamp(3)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  committee   Committee? @relation(fields: [committeeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([committeeId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(uuid()) @map("id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at") @db.Timestamp(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamp(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
